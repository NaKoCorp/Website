{#- Cover of article 09, drawn with the theme's colours. Decorative: the title
    sits next to it. On the left, your machine running barking-node: a
    status light, a terminal with the start command and its log line, and
    the UDP 4433 port on its right edge (accent). Below it, node.db: a tray
    of sealed packets (hatched, padlocked), the only thing the node keeps.
    On the right, three peer relays, joined to the port by dashed lines in
    the internet transport colour (replication travels between relays).
    The resting state is the end of the story: light on, three peers
    linked, the tray holding four sealed packets. Motion, once, only
    without reduced motion: the light comes on, the log line prints, the
    peers join one after another, then the packets settle into the tray.
    No loop. Text: commands, hex and a port number, so it needs no
    translation. -#}
{%- set peers = [
  { x: 504, y: 72, n: 1 },
  { x: 536, y: 158, n: 2 },
  { x: 504, y: 244, n: 3 }
] -%}
<svg class="cover-art cover-relay" viewBox="0 0 640 360" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" font-family="var(--font-mono)">
<defs>
<pattern id="relay-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
<path d="M0 0V6" stroke="var(--cover-line)" stroke-width="1.5" opacity=".45"/>
</pattern>
</defs>
<rect width="640" height="360" fill="var(--cover-bg)"/>
<g fill="none" stroke="var(--cover-grid)" stroke-width="1" opacity=".6">
<path d="M0 60H640M0 120H640M0 180H640M0 240H640M0 300H640"/>
<path d="M80 0V360M160 0V360M240 0V360M320 0V360M400 0V360M480 0V360M560 0V360"/>
</g>
<g fill="none" stroke="var(--transport-net)" stroke-width="1.5" stroke-dasharray="4 6" stroke-linecap="round">
{%- for p in peers %}
<path class="relay-link relay-late-{{ p.n }}" d="M400 180C448 180 456 {{ p.y + 22 }} {{ p.x }} {{ p.y + 22 }}"/>
{%- endfor %}
</g>
{%- for p in peers %}
<g class="relay-peer relay-late-{{ p.n }}" transform="translate({{ p.x }} {{ p.y }})">
<rect width="72" height="44" rx="10" fill="var(--cover-node)" stroke="var(--cover-line)" stroke-width="1.5"/>
<path d="M14 16H44M14 28H36" stroke="var(--cover-chip)" stroke-width="3" stroke-linecap="round"/>
<circle cx="56" cy="22" r="4" fill="var(--cover-line)"/>
</g>
{%- endfor %}
<rect x="48" y="60" width="312" height="172" rx="16" fill="var(--cover-node)" stroke="var(--cover-line)" stroke-width="1.5"/>
<path d="M48 96H360" stroke="var(--cover-chip)" stroke-width="1.5"/>
<circle class="relay-led" cx="72" cy="78" r="6" fill="var(--accent)"/>
<text x="88" y="82" font-size="12" fill="var(--cover-line)">barking-node</text>
<g fill="var(--cover-chip)"><circle cx="312" cy="78" r="3"/><circle cx="324" cy="78" r="3"/><circle cx="336" cy="78" r="3"/></g>
<g font-size="12">
<text x="68" y="128" fill="var(--cover-line)">$ barking-node run</text>
<text class="relay-log" x="68" y="156" fill="var(--accent)">node 7Q3F…K4AM started</text>
<text class="relay-log2" x="68" y="184" fill="var(--cover-line)">deposits accepted: 4</text>
</g>
<g class="relay-port">
<rect x="324" y="164" width="76" height="32" rx="10" fill="var(--cover-node)" stroke="var(--accent)" stroke-width="2"/>
<text x="362" y="184" text-anchor="middle" font-size="11" fill="var(--accent)">UDP 4433</text>
</g>
<path d="M120 232V256M288 232V256" stroke="var(--cover-line)" stroke-width="1.5"/>
<rect x="72" y="256" width="264" height="60" rx="12" fill="var(--cover-node)" stroke="var(--cover-line)" stroke-width="1.5"/>
<text x="88" y="290" font-size="11" fill="var(--cover-line)">node.db</text>
{%- for i in range(4) %}
{%- set x = 160 + 40 * i %}
<rect x="{{ x }}" y="272" width="32" height="28" rx="6" fill="none" stroke="var(--cover-chip)" stroke-width="1.5" stroke-dasharray="3 4"/>
<g class="relay-pkt relay-pkt-{{ i + 1 }}">
<rect x="{{ x }}" y="272" width="32" height="28" rx="6" fill="url(#relay-hatch)" stroke="var(--cover-line)" stroke-width="1.5"/>
<rect x="{{ x + 10 }}" y="285" width="12" height="9" rx="2" fill="var(--accent)"/>
<path d="M{{ x + 12 }} 285V282a4 4 0 0 1 8 0V285" fill="none" stroke="var(--accent)" stroke-width="1.5"/>
</g>
{%- endfor %}
</svg>
