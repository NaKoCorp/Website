{%- set l = site.labels[lang] -%}
{#- Same footer as the homepage (src/index.html), on Ink, with the FrenchMark. -#}
<footer class="site-footer">
  <div class="blog-wrap footer-inner">
    <p class="footer-copy"><span class="logo-tile logo-tile-sm"><img src="/assets/nakocorp-logo.svg" alt="" width="36" height="34"></span><span>{{ l.footerCopy }}</span></p>
    <p class="footer-links">
      <a href="/{{ lang }}/blog/">{{ l.blog }}</a>
      <a href="https://github.com/nakocorp/barking" target="_blank" rel="noopener">GitHub</a>
      <a href="https://github.com/nakocorp" target="_blank" rel="noopener">github.com/nakocorp</a>
      <a href="/{{ lang }}/feed.xml">Atom</a>
      <span class="french-mark"><img src="/assets/blog/coq-dark.svg" alt="" width="18" height="18">{{ l.frenchMark }}</span>
    </p>
  </div>
</footer>
