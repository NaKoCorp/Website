{%- set l = site.labels[lang] -%}
<footer class="site-footer">
  <div class="blog-wrap footer-inner">
    <p class="footer-copy"><span class="logo-tile logo-tile-sm"><img src="/assets/nakocorp-logo.svg" alt="" width="36" height="34"></span><span>{{ l.footerCopy }}</span></p>
    <p class="footer-links">
      <a href="https://github.com/nakocorp/barking">GitHub</a>
      <a href="/{{ lang }}/feed.xml">Atom</a>
      {#- The coq follows the theme: coq-light on Paper, coq-dark on Ink. #}
      <span class="french-mark"><img class="coq-light" src="/assets/blog/coq-light.svg" alt="" width="18" height="18"><img class="coq-dark" src="/assets/blog/coq-dark.svg" alt="" width="18" height="18">{{ l.frenchMark }}</span>
    </p>
  </div>
</footer>
